{
    "name": "inpost-izi-prestashop/inpostizi",
    "autoload": {
        "psr-4": {
            "izi\\prestashop\\": "src/",
            "izi\\": "lib/"
        },
        "files": [
            "bootstrap.php"
        ]
    },
    "require": {
        "php": ">=7.1.3",
        "psr/clock": "^1.0",
        "nyholm/psr7": "^1.6",
        "psr/http-client": "^1.0",
        "symfony/service-contracts": "^1.10",
        "psr/simple-cache": "^1.0",
        "maennchen/zipstream-php": "^2.1",
        "symfony/config": "^3.4.31"
    },
    "replace": {
        "symfony/filesystem": "^3.4 || ^4.4",
        "symfony/polyfill-ctype": "^1.11"
    },
    "config": {
        "preferred-install": "dist",
        "prepend-autoloader": false,
        "platform-check": false,
        "platform": {
            "php": "7.1.3"
        }
    }
}
