{
    "name": "inpost-izi-prestashop/inpostizi",
    "autoload": {
        "psr-4": {
            "izi\\prestashop\\": "src/"
        },
        "classmap": [
            "inpostizi.php"
        ],
        "exclude-from-classmap": [
            "src/Environment/UatEnvironment.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "InPost\\Izi\\PHPStan\\": "tests/phpstan"
        }
    },
    "require": {
        "php": ">=7.2.5",
        "psr/clock": "^1.0",
        "nyholm/psr7": "^1.6",
        "psr/http-client": "^1.0",
        "symfony/service-contracts": "^1.10",
        "symfony/translation-contracts": "^1.10",
        "psr/simple-cache": "^1.0",
        "maennchen/zipstream-php": "^2.1",
        "symfony/polyfill-php80": "^1.29",
        "composer/semver": "^3.4"
    },
    "config": {
        "preferred-install": "dist",
        "prepend-autoloader": false,
        "platform-check": false,
        "platform": {
            "php": "7.2.5"
        }
    },
    "require-dev": {
        "prestashop/php-dev-tools": "^5.0",
        "friendsofphp/php-cs-fixer": "^3.4",
        "phpstan/phpstan": "^1.12"
    }
}
