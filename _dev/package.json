{
  "name": "inpost-pay",
  "description": "",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "eslint:lint": "eslint -c .eslintrc ./",
    "eslint:fix": "eslint -c .eslintrc ./ --fix",
    "eslint:lint:gitlab": "eslint -c .eslintrc ./ --format gitlab",
    "stylelint:lint": "stylelint 'src/**/*.{scss,css}'",
    "stylelint:fix": "stylelint 'src/**/*.{scss,css}' --fix",
    "stylelint:lint:gitlab": "stylelint --custom-formatter=@gitlab-formatters/stylelint-formatter-gitlab 'src/**/*.{scss,css}' --output-file=gl-code-quality-stylelint-report.json",
    "prettier:lint": "prettier --check '**/*.{js,mjs,jsx,ts,tsx,css,scss}'",
    "prettier:fix": "prettier --write '**/*.{js,mjs,jsx,ts,tsx,css,scss}'",
    "prettier:lint:gitlab": "prettier-formatter-gitlab 'prettier --l **/*.{js,mjs}'",
    "build:front": "prelude production --config-name front --progress",
    "watch:front": "prelude dev --watch --config-name front --progress"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@waynetecommerce/front-dev-tools": "^1.0.1",
    "@waynetecommerce/webpack-prelude": "^1.0.0"
  }
}
