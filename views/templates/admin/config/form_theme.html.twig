{% use 'bootstrap_4_layout.html.twig' %}

{% block _consents_configuration_consents_widget %}
  {% with {'child': prototype} %}
    <div {{ block('widget_container_attributes') }} data-prototype="{{ block('consent_collection_item_widget')|e('html_attr') }}">
      <div class="js-consent-collection-item-container">
        {% for child in form %}
          <div class="js-consent-collection-item">
            {{ block('consent_collection_item_widget') }}
          </div>
        {% endfor %}
      </div>

      <button type="button" class="js-add-consent-collection-item btn btn-outline-primary">
        <i class="material-icons">add_circle</i>
        {{ add_consent_label }}
      </button>
    </div>
  {% endwith %}
{% endblock %}

{% block consent_collection_item_widget %}
  <div class="input-group row">
    <div class="col-3">
      {{ form_label(child.cmsPageId, null, {
        'label_attr': {
          'class': 'p-0 mb-2'
        }
      }) }}

      <div class="form-group">
        {{ form_widget(child.cmsPageId) }}
      </div>
    </div>

    <div class="col-5">
      <div class="d-flex">
        {{ form_label(child.descriptions, null, {
          'label_attr': {
            'class': 'p-0 mb-2 d-inline w-auto'
          }
        }) }}
      </div>
      <div class="form-group">
        {{ form_widget(child.descriptions) }}
      </div>
    </div>

    <div class="col-3">
      {{ form_label(child.requirementType, null, {
        'label_attr': {
          'class': 'p-0 mb-2'
        }
      }) }}
      <div class="form-group">
        {{ form_widget(child.requirementType) }}
      </div>
    </div>

    <div class="input-group-btn col-1 m-auto">
      <button type="button" class="js-remove-consent-collection-item btn btn-outline-secondary float-right btn-sm" title="{{ 'Remove'|trans({}, 'Admin.Actions') }}">
        <i class="material-icons icon-delete">clear</i>
      </button>
    </div>
  </div>
{% endblock %}

{%- block integer_widget -%}
  {%- set type = type|default('number') -%}
  <div class="input-group">
    {{- block('form_widget_simple') -}}

    {% if form.vars.unit is defined %}
      <div class="input-group-append">
        <span class="input-group-text">{{ form.vars.unit }}</span>
      </div>
    {% endif %}
  </div>
{%- endblock integer_widget -%}

{% block form_label -%}
  {{- parent() -}}

  {% if help is defined and help is not null %}
    <span
      class="help-box"
      data-toggle="popover"
      data-html="true"
      data-trigger="hover"
      data-placement="top"
      data-content="{{ help }}"
    >
       </span>
  {% endif %}
{%- endblock form_label %}


{% block checkbox_widget -%}
  <div class="custom-control custom-checkbox">
    <input
      type="checkbox"
      class="custom-control-input"
      {{ block('widget_attributes') }}
      {% if value is defined %} value="{{ value }}"{% endif %}
      {% if checked %} checked="checked"{% endif %}
    >
    <label
      class="custom-control-label"
      for="{{ id }}"
    >
      {% if help is defined and help is not null %}
        {{ label }}
      {% endif %}
      {% if help is defined and help is not null %}
        <span
          class="help-box"
          data-toggle="popover"
          data-html="true"
          data-trigger="hover"
          data-placement="top"
          data-content="{{ help }}"
        >
        </span>
      {% endif %}
    </label>
  </div>
{%- endblock checkbox_widget %}
