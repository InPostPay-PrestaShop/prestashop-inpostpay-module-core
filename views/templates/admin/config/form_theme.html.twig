{% use 'bootstrap_4_layout.html.twig' %}

{% block _consents_configuration_consents_widget %}
  {% with {'child': prototype} %}
    <div {{ block('widget_container_attributes') }} data-prototype="{{ block('consent_collection_item_widget')|e('html_attr') }}">
      <div class="js-consent-collection-item-container">
        {% for child in form %}
          <div class="js-consent-collection-item">
            {{ block('consent_collection_item_widget') }}
          </div>
        {% endfor %}
      </div>

      <button type="button" class="js-add-consent-collection-item btn btn-outline-primary">
        <i class="material-icons">add_circle</i>
        {{ add_consent_label }}
      </button>
    </div>
  {% endwith %}
{% endblock %}

{% block consent_collection_item_widget %}
  <div class="input-group row">
    <div class="col-3">
      {{ form_label(child.cmsPageId, null, {
        'label_attr': {
          'class': 'p-0 mb-2'
        }
      }) }}

      <div class="form-group">
        {{ form_widget(child.cmsPageId) }}
      </div>
    </div>

    <div class="col-5">
      <div class="d-flex">
        {{ form_label(child.descriptions, null, {
          'label_attr': {
            'class': 'p-0 mb-2 d-inline w-auto'
          }
        }) }}
      </div>
      <div class="form-group">
        {{ form_widget(child.descriptions) }}
      </div>
    </div>

    <div class="col-3">
      {{ form_label(child.requirementType, null, {
        'label_attr': {
          'class': 'p-0 mb-2'
        }
      }) }}
      <div class="form-group">
        {{ form_widget(child.requirementType) }}
      </div>
    </div>

    <div class="input-group-btn col-1 m-auto">
      <button type="button" class="js-remove-consent-collection-item btn btn-outline-secondary float-right btn-sm" title="{{ 'Remove'|trans({}, 'Admin.Actions') }}">
        <i class="material-icons icon-delete">clear</i>
      </button>
    </div>
  </div>
{% endblock %}

{%- block integer_widget -%}
  {%- set type = type|default('number') -%}
  <div class="input-group">
    {{- block('form_widget_simple') -}}

    {% if form.vars.unit is defined %}
      <div class="input-group-append">
        <span class="input-group-text">{{ form.vars.unit }}</span>
      </div>
    {% endif %}
  </div>
{%- endblock integer_widget -%}

{% block form_label_errors -%}
  {% if help is defined and help is not null %}
    <span
        class="help-box mr-0"
        data-toggle="popover"
        data-html="true"
        data-trigger="hover"
        data-placement="top"
        data-content="{{ help }}"
    ></span>
  {% endif %}

  {{- parent() -}}
{%- endblock form_label_errors %}

{% block checkbox_widget -%}
  <div class="custom-control custom-checkbox">
    <input
      type="checkbox"
      class="custom-control-input"
      {{ block('widget_attributes') }}
      {% if value is defined %} value="{{ value }}"{% endif %}
      {% if checked %} checked="checked"{% endif %}
    >
    <label
      class="custom-control-label"
      for="{{ id }}"
    >
      {% if help is defined and help is not null %}
        {{ label }}
      {% endif %}
      {% if help is defined and help is not null %}
        <span
          class="help-box"
          data-toggle="popover"
          data-html="true"
          data-trigger="hover"
          data-placement="top"
          data-content="{{ help }}"
        >
        </span>
      {% endif %}
    </label>
  </div>
{%- endblock checkbox_widget %}

{% block shipping_options_row %}
  {% if label is not same as(false) %}
    <label class="h3 mb-3" for="{{ form.vars.id }}">
      {{ label }}
    </label>
  {% endif %}

  {{ form_errors(form) }}
  {{ form_rest(form) }}
{% endblock %}

{% block carrier_mappings_row %}
  <div class="row mt-n2 align-items-end">
    {% for child in form %}
      <div class="col-xl-3 col-md-6 col-12 mt-2">
        {{ form_row(child) }}
      </div>
    {% endfor %}
  </div>
{% endblock %}

{% block service_options_row %}
  {% if label is not same as(false) %}
    <label class="h4" for="{{ form.vars.id }}">
      {{ label }}
    </label>
  {% endif %}

  <div class="row mt-n2">
    <div class="col-xl-4 col-md-6 col-12 mt-2">
      {{ form_row(form.additionalCost) }}
    </div>
    <div class="offset-xl-0 offset-6"></div>

    {{ form_rest(form) }}
  </div>
{% endblock %}

{% block time_of_week_range_row %}
  {{ form_rest(form) }}
{% endblock %}

{% block time_of_week_row %}
  <div class="col-xl-4 col-md-6 col-12 mt-2">
    <fieldset class="form-group">
      {{ form_label(form, null, {'label_attr': { 'class': 'p-0 mb-2'} }) }}

      <div class="row mx-n1">
        <div class="col-sm px-1">
          {{ form_widget(form.weekDay) }}
          {{ form_errors(form.weekDay) }}
        </div>
        <div class="col-sm px-1">
          {{ form_widget(form.time) }}
          {{ form_errors(form.time) }}
        </div>

        {{ form_rest(form) }}
      </div>
    </fieldset>
  </div>
{% endblock %}

{% block form_help %}{% endblock %}
