{% set form = form.ordersConfiguration.messageOptions %}

<p class="h3 mb-3">
  {{ form_label(form, null, {
    'label_attr': {
      'class': 'p-0'
    }
  }) }}
</p>

<div class="row mt-3 align-items-baseline">
  {% if form.appendIfApmDelivery is defined %}
    <div class="col-xl-4 col-lg-6 col-md-12">
      {{ form_row(form.appendIfApmDelivery) }}

      <p class="text-muted">{{ form.vars.details|raw }}</p>
    </div>

    <div class="col-xl-8 col-lg-6 col-md-12">
      {{ form_row(form.message) }}
    </div>
  {% else %}
    <div class="col-xl-8 col-lg-6 col-md-12">
      {{ form_row(form.message) }}

      <p class="text-muted">{{ form.vars.details|raw }}</p>
    </div>
  {% endif %}
</div>
