<div class="row mt-n2">
  <div class="col-xxl-auto col-12 col-xs-12 mt-2">
    {{ form_row(formDisplay) }}
  </div>

  {% set style_forms = ['minWidthPx', 'maxWidthPx', 'minHeightPx'] %}
  {% if form.vars.for_v2 is defined and form.vars.for_v2 %}
    {% set style_forms = style_forms|merge(['alignment']) %}
  {% endif %}

  {% for name, child in form %}
    {% if name not in style_forms %}
      <div class="col-xxl col-xl-3 col-sm-6 col-12 col-xs-12 mt-2">
        {{ form_row(child) }}
      </div>
    {% endif %}
  {% endfor %}
</div>

<div class="row">
  {% for child in form %}
    {% if not child.rendered %}
    <div class="col-xl-3 col-sm-6 col-12 col-xs-12 mt-2">
      {{ form_row(child) }}
    </div>
    {% endif %}
  {% endfor %}
</div>
